# ====================================================================
# 1. SECURITY & SECRETS (Never upload your keys!)
# ====================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret

# ====================================================================
# 2. DEPENDENCIES (Giant folders that break GitHub)
# ====================================================================
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# ====================================================================
# 3. BUILD & OUTPUTS (Folders created automatically during deployment)
# ====================================================================
dist/
build/
out/
.next/
.vercel/
bin/
obj/

# ====================================================================
# 4. SYSTEM FILES (Junk files made by your computer/code editor)
# ====================================================================
# Mac junk
.DS_Store
.AppleDouble
.LSOverride

# Windows junk
Thumbs.db
Ehthumbs.db
Desktop.ini

# Code Editor junk (VS Code, WebStorm)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ====================================================================
# 5. LOGS & DIAGNOSTICS (Error records)
# ====================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
